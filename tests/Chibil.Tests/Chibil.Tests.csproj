<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FieldBackedAggregateTests)' == 'true'">
    <DefineConstants>$(DefineConstants);FIELD_BACKED_AGGREGATES</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OptimizedTests)' == 'true'">
    <DefineConstants>$(DefineConstants);OPTIMIZED_TESTS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <FixtureTargetFramework>net481</FixtureTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NetCoreTests)' == 'true'">
    <DefineConstants>$(DefineConstants);NETCORE_TESTS</DefineConstants>
    <FixtureTargetFramework>net10.0</FixtureTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit.v3" Version="3.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Asm2ObjAssembly\**" />
    <Compile Remove="ReflectionProbe\**" />
    <Compile Remove="ChilinkAssembly\**" />
    <Compile Remove="ChilinkInitializerAssembly\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\chibil\Chibil.csproj" />
    <ProjectReference Include="..\..\chilink\Chilink.csproj" />
    <ProjectReference Include="..\..\tools\asm2obj\Asm2Obj.csproj" />
    <!--
      The CRT shim assembly is built as a side artifact and embedded into
      the test assembly for both targets. AddCrt selects the resource
      matching the compilation target.
      CompilationBuilder.AddCrt() extracts it at test time, runs asm2obj
      on it, and adds the resulting .obj to the link.
    -->
    <ProjectReference Include="..\..\crt\crt.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>EmbeddedResource</OutputItemType>
      <LogicalName>crt.net481.dll</LogicalName>
      <SetTargetFramework>TargetFramework=net481</SetTargetFramework>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\crt\crt.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>EmbeddedResource</OutputItemType>
      <LogicalName>crt.net10.dll</LogicalName>
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <!--
      The Asm2ObjAssembly test fixture is built as a side artifact and
      embedded as "Asm2ObjAssembly.dll". CompilationBuilder.AddAsm2ObjAssembly()
      extracts it at test time, runs asm2obj on it, and adds the resulting
      .obj to the link. See Asm2ObjAnnotationsTests for the end-to-end test.
    -->
    <ProjectReference Include="Asm2ObjAssembly\Asm2ObjAssembly.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>EmbeddedResource</OutputItemType>
      <LogicalName>Asm2ObjAssembly.dll</LogicalName>
      <SetTargetFramework>TargetFramework=$(FixtureTargetFramework)</SetTargetFramework>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <!--
      The ReflectionProbe fixture is built as a side artifact and embedded as
      "ReflectionProbe.dll". The function/data-sections tests run it through
      AddAsm2ObjAssembly("ReflectionProbe.dll") to observe /OPT:REF dead-stripping
      at runtime via reflection. See FunctionDataSectionsTests.
    -->
    <ProjectReference Include="ReflectionProbe\ReflectionProbe.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>EmbeddedResource</OutputItemType>
      <LogicalName>ReflectionProbe.dll</LogicalName>
      <SetTargetFramework>TargetFramework=$(FixtureTargetFramework)</SetTargetFramework>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="ChilinkAssembly\ChilinkAssembly.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>EmbeddedResource</OutputItemType>
      <LogicalName>ChilinkAssembly.dll</LogicalName>
      <SetTargetFramework>TargetFramework=$(FixtureTargetFramework)</SetTargetFramework>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <ProjectReference Include="ChilinkInitializerAssembly\ChilinkInitializerAssembly.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>EmbeddedResource</OutputItemType>
      <LogicalName>ChilinkInitializerAssembly.dll</LogicalName>
      <SetTargetFramework>TargetFramework=$(FixtureTargetFramework)</SetTargetFramework>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

</Project>
